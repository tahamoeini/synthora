{
  "name": "invest-consult",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,css,html}\"",
    "fix": "npm run format && npm run lint:fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "check": "node scripts/check-syntax.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "espree": "^11.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
